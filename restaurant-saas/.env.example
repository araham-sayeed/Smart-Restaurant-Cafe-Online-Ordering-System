# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=restaurant_saas
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/restaurant_saas
# If running inside Docker Compose container:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/restaurant_saas

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
# If running inside Docker Compose container:
# REDIS_URL=redis://redis:6379/0

# Authentication & Security
JWT_SECRET=supersecretdevkeychangeinproduction1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL
FRONTEND_URL=http://localhost:5173

# OTP (dev: show code in API response + top banner)
OTP_REQUIRED=true
EXPOSE_DEV_OTP=true
